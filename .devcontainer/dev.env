# Development settings for the `dev` container. Fixed credentials for local services only:
# never use these values anywhere else.
LEKTO_LOG_FORMAT=console
LEKTO_LOG_LEVEL=DEBUG

# Encrypts TOTP secrets; required for the API. Production: `openssl rand -base64 32`.
LEKTO_SECRET_KEY=ZGV2LWtleS1kZXYta2V5LWRldi1rZXktZGV2LWtleS0=
# The first admin, created at API start while there is none.
LEKTO_ADMIN_USERNAME=admin
LEKTO_ADMIN_PASSWORD=lekto-dev-admin
# The API is reached over plain HTTP during development.
LEKTO_COOKIE_SECURE=false

LEKTO_DB_TYPE=postgres
LEKTO_DB_HOST=postgres
LEKTO_DB_PORT=5432
LEKTO_DB_NAME=lekto
LEKTO_DB_USER=lekto
LEKTO_DB_PASSWORD=lekto

LEKTO_STORAGE_TYPE=s3
LEKTO_S3_ENDPOINT_URL=http://garage:3900
LEKTO_S3_REGION=garage
LEKTO_S3_BUCKET=lekto
LEKTO_S3_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeef
LEKTO_S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LEKTO_S3_PATH_STYLE=true

LEKTO_MEILISEARCH_URL=http://meilisearch:7700
LEKTO_MEILISEARCH_API_KEY=dev-meilisearch-master-key

# No language model in the devcontainer. To use Ollama on the host, uncomment and adjust:
# LEKTO_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LEKTO_LLM_MODEL=
# LEKTO_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# LEKTO_EMBEDDING_MODEL=snowflake-arctic-embed2
# Queries want a prefix with this model (the documents none).
# LEKTO_EMBEDDING_QUERY_PREFIX=query:
# The length of the vectors; the search index is set up for it (snowflake-arctic-embed2: 1024).
# LEKTO_EMBEDDING_DIMENSIONS=1024

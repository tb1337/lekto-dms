# Settings of the development instance in the devcontainer: copy to live.env (not in the
# repository) or let the VS Code task "Lekto: Devinstanz einrichten" do it. The instance shares
# Postgres, Garage and Meilisearch with development and tests, but has its own database, bucket
# and index, so nothing deletes or overwrites its data. See .devcontainer/README.md.
LEKTO_LOG_FORMAT=console
LEKTO_LOG_LEVEL=INFO

# 32 random bytes, base64 (`openssl rand -base64 32`); the setup task fills it in. Keep it:
# TOTP and webhook secrets cannot be read without it.
LEKTO_SECRET_KEY=
# The first admin, created at API start while there is none. Use the user name of the owner of
# your documents in Paperless, so that the migration maps them to you.
LEKTO_ADMIN_USERNAME=
LEKTO_ADMIN_PASSWORD=
# Plain HTTP inside the devcontainer.
LEKTO_COOKIE_SECURE=false

LEKTO_DB_TYPE=postgres
LEKTO_DB_HOST=postgres
LEKTO_DB_PORT=5432
LEKTO_DB_NAME=lekto_live
LEKTO_DB_USER=lekto
LEKTO_DB_PASSWORD=lekto

LEKTO_STORAGE_TYPE=s3
LEKTO_S3_ENDPOINT_URL=http://garage:3900
LEKTO_S3_REGION=garage
LEKTO_S3_BUCKET=lekto-live
LEKTO_S3_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeef
LEKTO_S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LEKTO_S3_PATH_STYLE=true

LEKTO_MEILISEARCH_URL=http://meilisearch:7700
LEKTO_MEILISEARCH_API_KEY=dev-meilisearch-master-key
LEKTO_MEILISEARCH_INDEX=lekto-live-documents

# The built web UI, served below /ui (the task "Lekto: UI bauen" writes it).
LEKTO_UI_DIR=../web/build

# Jobs at the same time; the OCR shares the CPU cores among them (backend/README.md, Worker).
LEKTO_WORKER_CONCURRENCY=3

# Language model and embeddings via Open WebUI (OpenAI-compatible, in front of Ollama). The base
# URL is Open WebUI's `/api`; the key is from Settings > Account > API keys. On a CPU a document
# takes minutes; see the rules for mass runs in .devcontainer/README.md.
LEKTO_LLM_BASE_URL=https://openwebui.example.org/api
LEKTO_LLM_API_KEY=
LEKTO_LLM_MODEL=qwen3:8b-ctx8k
LEKTO_LLM_TIMEOUT=600
LEKTO_EMBEDDING_BASE_URL=https://openwebui.example.org/api
LEKTO_EMBEDDING_API_KEY=
LEKTO_EMBEDDING_MODEL=snowflake-arctic-embed2:latest
LEKTO_EMBEDDING_QUERY_PREFIX=query:
LEKTO_EMBEDDING_DIMENSIONS=1024

# Optional: a vision language model that reads a document's pages when you press "Read with
# VLM" (page images go there, only then). It must take images and give pixel boxes.
# LEKTO_VLM_BASE_URL=https://openwebui.example.org/api
# LEKTO_VLM_API_KEY=
# LEKTO_VLM_MODEL=anthropic.claude-sonnet-5-5

# Optional: fetch the logos of contacts from their own websites (HTTPS to public addresses
# only; the worker asks a contact's website once it has a domain among its identifiers, and the
# task "Lekto: Logos holen" for all of them). Off, Lekto never asks the web on its own; uploaded
# logos work either way.
# LEKTO_LOGO_FETCH=true

# Migration from Paperless-ngx (migration/README.md): the Paperless key only as a file outside
# the repository, the Lekto token of an admin with scope read_write from the UI (Settings).
LEKTO_MIGRATION_PAPERLESS_URL=http://host.docker.internal:8765
LEKTO_MIGRATION_PAPERLESS_TOKEN_FILE=/tmp/paperless-token
LEKTO_MIGRATION_LEKTO_URL=http://localhost:8000
LEKTO_MIGRATION_LEKTO_TOKEN_FILE=/tmp/lekto-token

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
.svelte-kit/

# Environment
.env
.env.*
!.env.example

# Local data
data/

# IDE: keep design documents in .idea, ignore JetBrains files; VS Code: only the tasks
.idea/*
!.idea/*.md
!.idea/prompts/
!.idea/reviews/
.vscode/*
!.vscode/tasks.json
.DS_Store

# The settings of the development instance in the devcontainer (.devcontainer/README.md)
.devcontainer/*.env

# Settings and secrets of the Compose examples, and what they keep next to them: the migration's
# working folder, certificates for nginx, backups (deploy/README.md)
docker/.env
docker/migration/
docker/certs/
docker/backup/
# Left from the examples before 0.6 (deploy/create-secrets.sh): keep them out of the repository.
deploy/secrets/
deploy/backup/

# Migration client: local state and reports of a run
migration-state.sqlite*
migration-plan.yaml
migration-reports/

# pnpm store created by runs from the repository root
.pnpm-store/

# Backups of the development instance (.devcontainer/README.md)
backup/

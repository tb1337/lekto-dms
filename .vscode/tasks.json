{
	// Lekto as a development instance inside the devcontainer (see .devcontainer/README.md).
	// Every task runs in /workspaces/lekto with the settings of .devcontainer/dev.local.env (not in the
	// repository; "Lekto: Set up dev instance" creates it). Only "zsh" starts on its own.
	"version": "2.0.0",
	"options": {
		"shell": { "executable": "/bin/bash", "args": ["-c"] }
	},
	"tasks": [
		{
			// A terminal when the folder opens, after a rebuild too: the one of postCreateCommand
			// closes when it is done, and VS Code hides the panel with it. Without dev.local.env.
			"label": "zsh",
			"detail": "A terminal when the folder opens",
			"type": "process",
			"command": "zsh",
			"args": ["-l"],
			"problemMatcher": [],
			"presentation": { "panel": "dedicated", "reveal": "always", "focus": true, "close": true },
			"runOptions": { "runOn": "folderOpen" }
		},
		{
			"label": "Lekto: Set up dev instance",
			"detail": "Once: dev.local.env from the example, database lekto_dev, bucket lekto-dev",
			"type": "shell",
			"command": ".devcontainer/dev-setup.sh",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Migrate schema",
			"detail": "Bring the database of the dev instance to the newest schema",
			"type": "shell",
			"command": "set -a && . .devcontainer/dev.local.env && set +a && cd backend && uv run python -m lekto.composition migrate",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Build UI",
			"detail": "Build the web UI into web/build; the API serves it below /ui",
			"type": "shell",
			"command": "cd web && pnpm build",
			"problemMatcher": []
		},
		{
			"label": "Lekto: API",
			"detail": "REST API, MCP and the built UI on http://localhost:8000/ui/",
			"type": "shell",
			"command": "set -a && . .devcontainer/dev.local.env && set +a && cd backend && uv run python -m lekto.composition api",
			"isBackground": true,
			"problemMatcher": {
				"owner": "lekto",
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "configuration valid",
					"endsPattern": "Application startup complete|Uvicorn running on"
				}
			},
			"presentation": { "group": "lekto", "panel": "dedicated", "reveal": "always" },
			"dependsOrder": "sequence",
			"dependsOn": ["Lekto: Migrate schema", "Lekto: Build UI"]
		},
		{
			"label": "Lekto: Worker",
			"detail": "Pipeline, events, webhooks, search index",
			"type": "shell",
			"command": "set -a && . .devcontainer/dev.local.env && set +a && cd backend && uv run python -m lekto.composition worker",
			"isBackground": true,
			"problemMatcher": {
				"owner": "lekto",
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "configuration valid",
					"endsPattern": "worker started"
				}
			},
			"presentation": { "group": "lekto", "panel": "dedicated", "reveal": "always" },
			"dependsOn": ["Lekto: Migrate schema"]
		},
		{
			"label": "Lekto: Start",
			"detail": "Migrate, build the UI, then API and worker side by side",
			"dependsOrder": "parallel",
			"dependsOn": ["Lekto: API", "Lekto: Worker"],
			"problemMatcher": []
		},
		{
			"label": "Lekto: Stop",
			"detail": "End the API and the worker tasks",
			"type": "shell",
			"command": "echo '${input:stopApi}${input:stopWorker}' >/dev/null; echo 'Lekto stopped'",
			"problemMatcher": []
		},
		{
			"label": "Lekto: UI dev",
			"detail": "Vite on http://localhost:5173/ui/ with /api proxied to the API on :8000",
			"type": "shell",
			"command": "cd web && pnpm dev",
			"isBackground": true,
			"problemMatcher": {
				"owner": "lekto",
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "VITE",
					"endsPattern": "Local:"
				}
			},
			"presentation": { "group": "lekto", "panel": "dedicated" }
		},
		{
			"label": "Lekto: Rebuild search index",
			"detail": "Rebuild the search index of the dev instance (reindex)",
			"type": "shell",
			"command": "set -a && . .devcontainer/dev.local.env && set +a && cd backend && uv run python -m lekto.composition reindex",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Render page images",
			"detail": "Queue the page images of documents from before the pages node (render-pages)",
			"type": "shell",
			"command": "set -a && . .devcontainer/dev.local.env && set +a && cd backend && uv run python -m lekto.composition render-pages",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Read codes",
			"detail": "Queue reading the bar and QR codes of documents from before code reading (read-codes)",
			"type": "shell",
			"command": "set -a && . .devcontainer/dev.local.env && set +a && cd backend && uv run python -m lekto.composition read-codes",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Fetch logos",
			"detail": "Queue fetching the logos of contacts without one from their websites (fetch-logos; needs LEKTO_LOGO_FETCH=true)",
			"type": "shell",
			"command": "set -a && . .devcontainer/dev.local.env && set +a && cd backend && uv run python -m lekto.composition fetch-logos",
			"problemMatcher": []
		},
		{
			// A new terminal for the migration from Paperless-ngx: in migration/, with the settings
			// of dev.local.env, the commands shown; it stays open for plan, check, prepare and run.
			"label": "Lekto: Migrate",
			"detail": "Take a Paperless-ngx archive over: a terminal in migration/ with dev.local.env, showing lekto-migration --help",
			"type": "shell",
			"command": "set -a && . .devcontainer/dev.local.env && set +a && cd migration && uv run lekto-migration --help; exec zsh -l",
			"problemMatcher": [],
			"presentation": { "panel": "new", "reveal": "always", "focus": true, "clear": true }
		}
	],
	"inputs": [
		{
			"id": "stopApi",
			"type": "command",
			"command": "workbench.action.tasks.terminate",
			"args": "Lekto: API"
		},
		{
			"id": "stopWorker",
			"type": "command",
			"command": "workbench.action.tasks.terminate",
			"args": "Lekto: Worker"
		}
	]
}

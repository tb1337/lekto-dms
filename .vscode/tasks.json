{
	// Lekto as a development instance inside the devcontainer (see .devcontainer/README.md).
	// Every task runs in /workspaces/papiq with the settings of .devcontainer/live.env (not in the
	// repository; "Lekto: Devinstanz einrichten" creates it). Nothing starts on its own.
	"version": "2.0.0",
	"options": {
		"shell": { "executable": "/bin/bash", "args": ["-c"] }
	},
	"tasks": [
		{
			"label": "Lekto: Devinstanz einrichten",
			"detail": "Once: live.env from the example, database lekto_live, bucket lekto-live",
			"type": "shell",
			"command": ".devcontainer/live-setup.sh",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Schema migrieren",
			"detail": "Bring the database of the dev instance to the newest schema",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd backend && uv run python -m lekto.composition migrate",
			"problemMatcher": []
		},
		{
			"label": "Lekto: UI bauen",
			"detail": "Build the web UI into web/build; the API serves it below /ui",
			"type": "shell",
			"command": "cd web && pnpm build",
			"problemMatcher": []
		},
		{
			"label": "Lekto: API",
			"detail": "REST API, MCP and the built UI on http://localhost:8000/ui/",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd backend && uv run python -m lekto.composition api",
			"isBackground": true,
			"problemMatcher": {
				"owner": "lekto",
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "configuration valid",
					"endsPattern": "Application startup complete|Uvicorn running on"
				}
			},
			"presentation": { "group": "lekto", "panel": "dedicated", "reveal": "always" },
			"dependsOrder": "sequence",
			"dependsOn": ["Lekto: Schema migrieren", "Lekto: UI bauen"]
		},
		{
			"label": "Lekto: Worker",
			"detail": "Pipeline, events, webhooks, search index",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd backend && uv run python -m lekto.composition worker",
			"isBackground": true,
			"problemMatcher": {
				"owner": "lekto",
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "configuration valid",
					"endsPattern": "worker started"
				}
			},
			"presentation": { "group": "lekto", "panel": "dedicated", "reveal": "always" },
			"dependsOn": ["Lekto: Schema migrieren"]
		},
		{
			"label": "Lekto starten",
			"detail": "Migrate, build the UI, then API and worker side by side",
			"dependsOrder": "parallel",
			"dependsOn": ["Lekto: API", "Lekto: Worker"],
			"problemMatcher": []
		},
		{
			"label": "Lekto stoppen",
			"detail": "End the API and the worker tasks",
			"type": "shell",
			"command": "echo '${input:stopApi}${input:stopWorker}' >/dev/null; echo 'Lekto stopped'",
			"problemMatcher": []
		},
		{
			"label": "Lekto: UI dev",
			"detail": "Vite on http://localhost:5173/ui/ with /api proxied to the API on :8000",
			"type": "shell",
			"command": "cd web && pnpm dev",
			"isBackground": true,
			"problemMatcher": {
				"owner": "lekto",
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "VITE",
					"endsPattern": "Local:"
				}
			},
			"presentation": { "group": "lekto", "panel": "dedicated" }
		},
		{
			"label": "Lekto: Suche neu aufbauen",
			"detail": "Rebuild the search index of the dev instance (reindex)",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd backend && uv run python -m lekto.composition reindex",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Seitenbilder nachholen",
			"detail": "Queue the page images of documents from before the pages node (render-pages)",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd backend && uv run python -m lekto.composition render-pages",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Codes nachholen",
			"detail": "Queue reading the bar and QR codes of documents from before code reading (read-codes)",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd backend && uv run python -m lekto.composition read-codes",
			"problemMatcher": []
		},
		{
			"label": "Lekto: Logos holen",
			"detail": "Queue fetching the logos of contacts without one from their websites (fetch-logos; needs LEKTO_LOGO_FETCH=true)",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd backend && uv run python -m lekto.composition fetch-logos",
			"problemMatcher": []
		},
		{
			"label": "Migration: plan",
			"detail": "Trial run against Paperless: reads, writes nothing",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd migration && uv run lekto-migration plan",
			"problemMatcher": []
		},
		{
			"label": "Migration: run",
			"detail": "Take the Paperless archive over into the dev instance (Ctrl-C stops, run again continues)",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd migration && uv run lekto-migration run",
			"problemMatcher": []
		},
		{
			"label": "Migration: verify",
			"detail": "Compare Paperless and Lekto object by object",
			"type": "shell",
			"command": "set -a && . .devcontainer/live.env && set +a && cd migration && uv run lekto-migration verify",
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "stopApi",
			"type": "command",
			"command": "workbench.action.tasks.terminate",
			"args": "Lekto: API"
		},
		{
			"id": "stopWorker",
			"type": "command",
			"command": "workbench.action.tasks.terminate",
			"args": "Lekto: Worker"
		}
	]
}

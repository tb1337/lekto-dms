#!/command/with-contenv sh
# lekto-run PROGRAM [ARGUMENT...]: run a program as PUID:PGID (not as root) with a writable HOME.
# Every Lekto process of the image starts through here.
set -eu
export HOME=/run/lekto-home
if [ "$(id -u)" -eq 0 ]; then
  exec s6-applyuidgid -u "${PUID:-1000}" -g "${PGID:-1000}" -G "" "$@"
fi
exec "$@"

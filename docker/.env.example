# Settings and secrets of the Compose examples in this folder. Copy this file to `.env` next to
# them and fill in what the examples you start need:
#
#   cp .env.example .env
#
# Secrets: generate them, never reuse these names as values. `openssl rand -base64 32` for a
# secret key, `openssl rand -hex 32` where a hex value is asked for. Every Lekto setting is listed
# in deploy/README.md and backend/README.md; the compose files pass on what they name.

# --- every example ----------------------------------------------------------------------------
# Signs the sessions and encrypts the webhook secrets: openssl rand -base64 32
LEKTO_SECRET_KEY=
# The first admin (`admin`), created at the first start.
LEKTO_ADMIN_PASSWORD=
# Meilisearch's master key: openssl rand -hex 32
MEILI_MASTER_KEY=
# The port on 127.0.0.1 without a proxy in front.
HTTP_PORT=8000

# --- language model and embeddings ------------------------------------------------------------
# Lekto sends document content there. Ollama on this machine by default; with compose.ollama.yml
# use http://ollama:11434/v1 for both; a cloud endpoint needs the API keys below.
LEKTO_LLM_BASE_URL=http://host.docker.internal:11434/v1
LEKTO_LLM_MODEL=qwen3:8b
LEKTO_LLM_API_KEY=
LEKTO_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
LEKTO_EMBEDDING_MODEL=snowflake-arctic-embed2
LEKTO_EMBEDDING_API_KEY=

# --- compose.postgres.yml ---------------------------------------------------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- compose.s3.yml (Garage) ------------------------------------------------------------------
# openssl rand -hex 32
GARAGE_RPC_SECRET=
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
# The key Lekto uses: "GK" and 24 hex digits (echo "GK$(openssl rand -hex 12)"), and its secret
# (openssl rand -hex 32).
LEKTO_S3_ACCESS_KEY_ID=
LEKTO_S3_SECRET_ACCESS_KEY=

# --- compose.caddy.yml, compose.traefik.yml, compose.nginx.yml --------------------------------
# The name Lekto is reached under; its DNS entry points to this machine.
DOMAIN=lekto.example.com
# Traefik: the address for Let's Encrypt.
ACME_EMAIL=
# nginx: the folder with fullchain.pem and privkey.pem.
TLS_DIR=./certs

# --- compose.migration.yml --------------------------------------------------------------------
# Paperless-ngx: its address as seen from the container, and an API token of a user who sees
# everything. Lekto: an admin's API token with scope read_write (Lekto, Settings, API tokens).
LEKTO_MIGRATION_PAPERLESS_URL=http://host.docker.internal:8000
LEKTO_MIGRATION_PAPERLESS_TOKEN=
LEKTO_MIGRATION_LEKTO_TOKEN=
